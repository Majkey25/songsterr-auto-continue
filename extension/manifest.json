{
  "manifest_version": 3,
  "name": "Songsterr Auto Continue",
  "version": "0.1.4",
  "description": "Automatically chooses Songsterr's free 'continue with sync pauses' action. Normal sync pauses remain.",
  "homepage_url": "https://github.com/Majkey25/songsterr-auto-continue",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://www.songsterr.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
